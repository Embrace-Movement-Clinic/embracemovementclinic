---
// Pilates & small group classes. Merges the old /pilates and /group-exercise-timetable pages.
import { getEntry, getEntries, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import OnPageNav from '../components/OnPageNav.astro';
import BookingTip from '../components/BookingTip.astro';
import CancellationCallout from '../components/CancellationCallout.astro';
import StepStrip from '../components/StepStrip.astro';
import Todo from '../components/Todo.astro';
import PractitionerList from '../components/PractitionerList.astro';
import ServiceCard from '../components/ServiceCard.astro';
import BookingBand from '../components/BookingBand.astro';
import ClosureNote from '../components/ClosureNote.astro';
import Timetable from '../components/Timetable.astro';
import { site } from '../data/site';
import { classFacts, classSteps, equipment, booking, timetable } from '../data/policies';

const service = (await getEntry('services', 'pilates')) as CollectionEntry<'services'>;
const d = service.data;
const related = (await getEntries(d.related)) as CollectionEntry<'services'>[];

const sections = [
  { href: '#start', label: 'How to start' },
  { href: '#for-you', label: 'Who it’s for' },
  { href: '#timetable', label: 'Timetable' },
  { href: '#studio', label: 'The studio' },
  { href: '#cancellations', label: 'Cancellations' },
  { href: '#who', label: 'Instructors' },
];
---

<BaseLayout title={d.seoTitle} description={d.seoDescription} shareImage={d.image ? `/og/services/${service.id}.jpg` : undefined} imageAlt={d.imageAlt}>
  <PageHero
    tone="brand"
    curve={false}
    crumbs={[{ label: 'Services', href: '/services' }, { label: 'Pilates & classes' }]}
    title={d.title}
    lede={d.lede}
  >
    <Fragment slot="actions">
      <Button href={site.booking.url} icon="calendar" size="l">Book now</Button>
      <Button href="#timetable" variant="secondary" size="l" class="wide-only">Timetable</Button>
      <Button href={site.phone.href} variant="secondary" size="l" icon="phone" class="phone-only">Call {site.phone.display}</Button>
    </Fragment>
    <Photo slot="aside" src={d.image} alt={d.imageAlt ?? ''} note={d.imageNote} position={d.imagePosition} ratio="4 / 3" tone="dark" loading="eager" sizes="(min-width: 56em) 45vw, 100vw" />
  </PageHero>

  <section class="on-brand factbar curve-bottom" aria-label="Class details">
    <div class="wrap">
      <dl class="factbar__list">
        {
          classFacts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <OnPageNav links={sections} />

  <section class="section section--tight" id="start" aria-labelledby="start-h">
    <div class="wrap">
      <StepStrip as="h2" id="start-h" title="How to start classes" steps={classSteps} />
      <BookingTip class="start__tip" />
    </div>
  </section>

  <section class="section section--alt" id="for-you" aria-labelledby="for-you-h">
    <div class="wrap two-col">
      <div>
        <SectionHead id="for-you-h" icon="heart" title={d.forYou.heading} class="for-you__head" />
        <ul class="icon-list ticks" role="list">
          {
            d.forYou.items.map((i) => (
              <li>
                <Icon name="check" size={20} />
                {i.name}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="expect">
        <h3>What to expect</h3>
        <p>{d.expect.text}</p>
      </div>
    </div>
  </section>

  <section class="section" id="timetable" aria-labelledby="timetable-h">
    <div class="wrap">
      <SectionHead id="timetable-h" icon="calendar" title="Timetable" intro={booking.classes} wide />
      <ClosureNote />
      {
        timetable ? (
          <Timetable days={timetable} />
        ) : (
          <Todo as="div">current class timetable as text (days and times, and who runs each class). The old timetable was an image from July 2025.</Todo>
        )
      }
      <div class="timetable__actions">
        <Button href={site.booking.url} icon="external">Check live availability</Button>
        <Button href={site.phone.smsHref} variant="secondary" icon="message">
          Text us to join a waitlist
        </Button>
      </div>
    </div>
  </section>

  <section class="section section--alt" id="studio" aria-labelledby="studio-h">
    <div class="wrap">
      <SectionHead id="studio-h" icon="dumbbell" title="Our clinic is equipped with" />
      <ul class="kit">
        {equipment.map((e) => <li>{e}</li>)}
      </ul>
      <p class="kit__more">And much more.</p>
    </div>
  </section>

  <section class="section" id="cancellations" aria-labelledby="cancel-h">
    <div class="wrap">
      <SectionHead id="cancel-h" icon="clock" title="Cancellation policy" />
      <CancellationCallout />
    </div>
  </section>

  <section class="section section--alt" id="who" aria-labelledby="who-h">
    <div class="wrap">
      <SectionHead id="who-h" icon="users" title="Who runs the classes" intro={d.practitionersNote} />
      <PractitionerList refs={d.practitioners} />
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="section" aria-labelledby="related-h">
        <div class="wrap">
          <SectionHead id="related-h">
            <span class="nowrap">One-on-one</span> appointments
          </SectionHead>
          <ul class="related" role="list">
            {related.map((r) => (
              <li>
                <ServiceCard service={r} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <BookingBand title="Ready to start classes?" text="Book your once-off pre-class assessment online, or call us to talk it through." />
</BaseLayout>

<style>
  .factbar {
    padding-bottom: calc(var(--space-l) + var(--curve) * 0.75);
  }

  .factbar__list {
    display: grid;
    gap: var(--space-s) var(--space-m);
    padding-top: var(--space-m);
    border-top: 1px solid color-mix(in srgb, currentColor 20%, transparent);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
  }

  .factbar dt {
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: var(--weight-bold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent-on-brand);
  }

  .factbar dd {
    margin: var(--space-3xs) 0 0;
  }

  :global(.start__tip) {
    margin-top: var(--space-s);
  }

  .two-col {
    display: grid;
    gap: var(--space-l);
  }

  @media (min-width: 56em) {
    .two-col {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl);
    }

  }

  /* The ticks sit close under the heading. */
  .two-col :global(.for-you__head) {
    margin-bottom: var(--space-m);
  }

  .ticks {
    font-weight: var(--weight-medium);
  }

  /* Native markers sit on the first line of each item, even when it wraps. */
  .kit {
    display: grid;
    gap: var(--space-xs) var(--space-l);
    padding-top: var(--space-xs);
    padding-left: 1.1em;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    line-height: 1.35;
  }

  @media (min-width: 56em) {
    .kit {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .kit li {
    padding-left: 0.2em;
    font-weight: var(--weight-medium);
  }

  .kit li::marker {
    color: var(--color-accent);
  }

  .kit__more {
    margin-top: var(--space-s);
    color: var(--color-ink-muted);
  }

  @media (max-width: 21.99em) {
    .kit {
      grid-template-columns: 1fr;
    }
  }

  .expect {
    display: grid;
    gap: var(--space-s);
    align-content: start;
    font-size: var(--step-1);
    line-height: 1.6;
  }

  :global(#timetable .closure) {
    margin-bottom: var(--space-m);
  }

  .timetable__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-m);
  }

  .related {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
  }
</style>
