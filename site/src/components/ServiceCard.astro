---
// A service as a photo card: photo, name, a sentence about it. Used in the services grid (compact)
// and in "You might also need" and practitioner pages (with a "Learn more" line).
import type { CollectionEntry } from 'astro:content';
import PhotoCard from './PhotoCard.astro';

interface Props {
  service: CollectionEntry<'services'>;
  /** Heading level for the service name. */
  as?: 'h3' | 'h4';
  /** Compact: the short blurb and no "Learn more" line (the whole card is the link). */
  compact?: boolean;
  sizes?: string;
  widths?: number[];
}

const { service, as: Heading = 'h3', compact = false, sizes = '(min-width: 62em) 33vw, (min-width: 40em) 50vw, 100vw', widths } = Astro.props;
const { title, summary, blurb, image, imagePosition, imageNote } = service.data;
---

<PhotoCard
  href={`/${service.id}`}
  image={image}
  imageNote={imageNote}
  imagePosition={imagePosition}
  sizes={sizes}
  widths={widths}
  more={compact ? undefined : 'Learn more'}
  class:list={['service-card', { 'service-card--compact': compact }]}
>
  <Heading class="h4 service-card__title">{title}</Heading>
  <p class="service-card__text">{compact ? (blurb ?? summary) : summary}</p>
</PhotoCard>

<style>
  .service-card__text {
    color: var(--color-ink-muted);
  }

  /* No "Learn more" line: the name underlines instead. */
  @media (hover: hover) {
    :global(.service-card--compact:hover) .service-card__title {
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }
  }
</style>
