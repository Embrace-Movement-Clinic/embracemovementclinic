---
import Wordmark from './Wordmark.astro';
import Icon from './Icon.astro';
import Button from './Button.astro';
import { getCollection } from 'astro:content';
import { primaryLinks } from '../data/navigation';
import { site, newTabAttrs } from '../data/site';
import { booking } from '../data/policies';

// News appears in the menu only while there are posts.
const serviceLinks = (await getCollection('services'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((s) => ({ label: s.data.title, href: `/${s.id}`, kind: s.data.kind }));
const serviceGroups = [
  { label: 'Classes', links: serviceLinks.filter((l) => l.kind === 'class') },
  { label: 'One-on-one appointments', links: serviceLinks.filter((l) => l.kind === 'appointment') },
];
// The mobile menu lists every service under Services, so leave out top-level links that repeat one (Classes).
const mobileLinks = primaryLinks.filter((l) => !serviceLinks.some((s) => s.href === l.href));

const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const current = (href: string) => (path === href ? 'page' : undefined);
const inServices = path === '/services' || serviceLinks.some((l) => l.kind === 'appointment' && l.href === path);
---

<header class="site-header">
  <div class="wrap site-header__bar">
    <a class="site-header__logo" href="/">
      <Wordmark />
      <span class="visually-hidden">{site.name} home</span>
    </a>

    <!-- Desktop navigation -->
    <nav class="desk-nav" aria-label="Main">
      <ul class="desk-nav__list" role="list">
        <li class="desk-nav__item desk-nav__item--has-sub" data-dropdown>
          <a href="/services" aria-current={current('/services')} class:list={[{ 'is-active': inServices }]}>Services</a>
          <button type="button" class="desk-nav__toggle" aria-expanded="false" aria-controls="services-menu" data-disclosure>
            <span class="visually-hidden">Services menu</span>
            <Icon name="chevron-down" size={18} />
          </button>
          <ul class="desk-nav__sub" id="services-menu" role="list">
            {
              serviceGroups.map((g) => (
                <li class="desk-nav__group">
                  <span class="desk-nav__group-label">{g.label}</span>
                  <ul role="list">
                    {g.links.map((l) => (
                      <li>
                        <a href={l.href} aria-current={current(l.href)}>
                          {l.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </li>
              ))
            }
            <li class="desk-nav__sub-all">
              <a href="/services">All services <Icon name="arrow-right" size={16} /></a>
            </li>
          </ul>
        </li>
        {
          primaryLinks.map((l) => (
            <li class="desk-nav__item">
              <a href={l.href} aria-current={current(l.href)}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="site-header__call" href={site.phone.href}>
        <Icon name="phone" size={20} />
        <span class="site-header__call-text"><span class="visually-hidden">Call </span>{site.phone.display}</span>
      </a>
      <Button href={site.booking.url} size="s" class="site-header__book">Book now</Button>
      {booking.portalUrl && (
        <Button href={booking.portalUrl} variant="secondary" size="s" class="site-header__portal">Patient portal</Button>
      )}
      <button type="button" class="site-header__menu" aria-expanded="false" aria-controls="mobile-nav" data-disclosure>
        <Icon name="menu" size={24} class="icon-open" />
        <Icon name="close" size={24} class="icon-close" />
        <span class="visually-hidden">Menu</span>
      </button>
    </div>
  </div>

  <!-- Mobile navigation (same links, kept after the menu button in reading order) -->
  <nav class="mobile-nav" id="mobile-nav" aria-label="Main">
    <ul class="wrap mobile-nav__list" role="list">
      <li>
        <a href="/services" aria-current={current('/services')}>Services</a>
        <ul class="mobile-nav__sub" role="list">
          {
            serviceLinks.map((l) => (
              <li>
                <a href={l.href} aria-current={current(l.href)}>
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </li>
      {
        mobileLinks.map((l) => (
          <li>
            <a href={l.href} aria-current={current(l.href)}>
              {l.label}
            </a>
          </li>
        ))
      }
      {booking.portalUrl && (
        <li class="mobile-nav__portal">
          <a href={booking.portalUrl} {...newTabAttrs(booking.portalUrl)}>
            Patient portal<span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        </li>
      )}
    </ul>
  </nav>
</header>

<script>
  // Disclosure buttons: services dropdown (desktop) and menu (mobile).
  const header = document.querySelector<HTMLElement>('.site-header');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-disclosure]');

  buttons.forEach((btn) => {
    const target = document.getElementById(btn.getAttribute('aria-controls') ?? '');
    if (!target) return;
    const isMenu = target.classList.contains('mobile-nav');
    const scope = btn.closest<HTMLElement>('[data-dropdown]') ?? header;
    const isOpen = () => btn.getAttribute('aria-expanded') === 'true';

    // The open menu fills the screen below the header, wherever the header sits (it's lower while
    // the notice banner shows above it), and scrolls inside if it's taller than that.
    const fitMenu = () => target.style.setProperty('--menu-top', `${Math.round(target.getBoundingClientRect().top)}px`);

    // While the menu is open the page behind it doesn't scroll and can't be tabbed into or read by
    // screen readers, so focus stays in the header (logo, call, book, menu).
    const lockPage = (lock: boolean) => {
      const root = document.documentElement;
      // Keeps the layout still if a visible scrollbar disappears.
      root.style.paddingRight = lock ? `${window.innerWidth - root.clientWidth}px` : '';
      root.classList.toggle('menu-open', lock);
      for (const el of document.body.children) {
        if (el !== header && el instanceof HTMLElement && el.tagName !== 'SCRIPT') el.inert = lock;
      }
    };

    const set = (open: boolean) => {
      if (open === isOpen()) return;
      btn.setAttribute('aria-expanded', String(open));
      target.toggleAttribute('data-open', open);
      if (!isMenu) return;
      lockPage(open);
      if (open) fitMenu();
    };

    btn.addEventListener('click', () => set(!isOpen()));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) {
        set(false);
        btn.focus();
      }
    });

    document.addEventListener(
      'click',
      (e) => {
        if (!scope || scope.contains(e.target as Node) || !isOpen()) return;
        // A tap on the dimmed page below the mobile menu only closes the menu, not follows a link there.
        if (isMenu) {
          e.preventDefault();
          e.stopPropagation();
        }
        set(false);
      },
      true,
    );

    // Close when focus leaves (the dropdown, or the header while the menu is open).
    scope?.addEventListener('focusout', (e) => {
      const next = (e as FocusEvent).relatedTarget as Node | null;
      if (next && !scope.contains(next)) set(false);
    });

    if (isMenu) {
      // Rotating or resizing: refit the menu, or close it if the menu button is no longer shown
      // (desktop width), so the page is never left locked.
      window.addEventListener('resize', () => {
        if (!isOpen()) return;
        if (btn.offsetParent === null) set(false);
        else fitMenu();
      });
      // Coming back to this page with the browser's Back button: start with the menu closed.
      window.addEventListener('pageshow', (e) => {
        if (e.persisted) set(false);
      });
    }
  });
</script>

<style>
  /* Header colours come from the --header-* tokens (white header bar). */
  .site-header {
    --btn-bg: var(--header-btn-bg);
    --btn-ink: var(--header-btn-ink);
    --color-focus: var(--header-focus);
    --divider: color-mix(in srgb, var(--header-ink) 14%, transparent);
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--header-bg);
    color: var(--header-ink);
    border-bottom: 1px solid var(--header-line);
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    /* The bar plus the header's 1px bottom border is exactly --header-h, which sticky bars and
       anchor offsets below the header rely on. */
    min-height: calc(var(--header-h) - 1px);
  }

  .site-header__logo {
    display: block;
    flex-shrink: 0;
    width: 7.5rem;
    margin-right: auto;
    padding-block: var(--space-2xs);
    color: inherit;
  }

  /* Wordmark in the logo's own colours when a logo-based palette is active. */
  .site-header__logo :global([data-part='top']) {
    fill: var(--header-wordmark-top, currentColor);
  }

  .site-header__logo :global([data-part='bottom']) {
    fill: var(--header-wordmark-bottom, currentColor);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  .site-header__call {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4em;
    min-width: 2.75rem;
    min-height: 2.75rem;
    border-radius: var(--radius-pill);
    color: inherit;
    font-family: var(--font-display);
    font-weight: 600;
    text-decoration: none;
  }

  .site-header__call:hover {
    background: var(--header-hover);
  }

  /* Number is visually hidden on small screens; the link still reads "Call 0434 686 261". */
  .site-header__call-text {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .site-header__menu {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: inherit;
  }

  .site-header__menu:hover {
    background: var(--header-hover);
  }

  .site-header__menu :global(.icon-close),
  .site-header__menu[aria-expanded='true'] :global(.icon-open) {
    display: none;
  }

  .site-header__menu[aria-expanded='true'] :global(.icon-close) {
    display: block;
  }

  /* Without JS the menu button can't work, so show the mobile nav as a plain list. */
  :global(html:not(.js)) .site-header__menu,
  :global(html:not(.js)) .desk-nav__toggle {
    display: none;
  }

  /* Mobile nav */
  .mobile-nav {
    border-top: 1px solid var(--divider);
    /* --menu-top is the menu's top edge on screen, set by the script when it opens. */
    max-height: calc(100dvh - var(--menu-top, var(--header-h)));
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  :global(html.js) .mobile-nav:not([data-open]) {
    display: none;
  }

  /* Dim the page below the open menu (the shadow is clipped so it never covers the header). */
  .mobile-nav[data-open] {
    box-shadow: 0 0 0 100vmax rgb(0 0 0 / 0.35);
    clip-path: inset(0 -100vmax -100vmax -100vmax);
  }

  .mobile-nav__list {
    padding-block: var(--space-2xs) var(--space-m);
    padding-left: 0;
    list-style: none;
  }

  .mobile-nav a {
    display: flex;
    align-items: center;
    min-height: 3rem;
    color: inherit;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid var(--divider);
  }

  .mobile-nav__sub {
    padding-left: var(--space-s);
    list-style: none;
  }

  .mobile-nav__sub a {
    font-family: var(--font-body);
    font-size: var(--step-0);
    font-weight: 500;
    color: color-mix(in srgb, var(--header-ink) 78%, var(--header-bg));
  }

  .mobile-nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }

  /* Desktop nav */
  .desk-nav {
    display: none;
  }

  /* Very narrow screens (320px phones, or 400% zoom): shrink the logo and gaps so
     Call, Book now and Menu all fit without sideways scrolling (WCAG 1.4.10). */
  @media (max-width: 24em) {
    .site-header__bar {
      gap: var(--space-2xs);
    }

    .site-header__logo {
      width: 6rem;
    }

    .site-header__actions {
      gap: var(--space-3xs);
    }

    .site-header__actions :global(.site-header__book) {
      padding-inline: 0.85em;
    }
  }

  @media (min-width: 30em) {
    .site-header__logo {
      width: 8.5rem;
    }
  }

  /* Patient portal: a second header button from tablet width up; in the menu on phones, where
     there's no room beside Book now. */
  .site-header__actions :global(.site-header__portal) {
    display: none;
  }

  @media (min-width: 40em) {
    .site-header__actions :global(.site-header__portal) {
      display: inline-flex;
    }

    .mobile-nav__portal {
      display: none;
    }
  }

  @media (min-width: 62em) {
    .site-header__bar {
      gap: var(--space-l);
    }

    .site-header__logo {
      width: 9.5rem;
      margin-right: 0;
    }

    .desk-nav {
      display: block;
      margin-right: auto;
    }

    .mobile-nav,
    .site-header__menu {
      display: none !important;
    }

    .desk-nav__list {
      display: flex;
      align-items: center;
      gap: var(--space-3xs);
      padding: 0;
      list-style: none;
    }

    .desk-nav__item {
      position: relative;
      display: flex;
      align-items: center;
    }

    .desk-nav__item > a {
      display: inline-flex;
      align-items: center;
      min-height: 2.75rem;
      padding-inline: 0.75rem;
      color: inherit;
      font-family: var(--font-display);
      font-weight: 550;
      text-decoration: none;
      white-space: nowrap;
      border-radius: var(--radius-pill);
    }

    .desk-nav__item--has-sub > a {
      padding-right: 0.15rem;
    }

    .desk-nav__item > a:hover {
      background: var(--header-hover);
    }

    .desk-nav__item > a[aria-current='page'],
    .desk-nav__item > a.is-active {
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 0.45em;
    }

    .desk-nav__toggle {
      display: inline-grid;
      place-items: center;
      width: 2rem;
      height: 2.75rem;
      border: 0;
      border-radius: var(--radius-pill);
      background: transparent;
      color: inherit;
    }

    .desk-nav__toggle:hover {
      background: var(--header-hover);
    }

    .desk-nav__toggle :global(svg) {
      transition: transform 0.2s var(--ease);
    }

    .desk-nav__toggle[aria-expanded='true'] :global(svg) {
      transform: rotate(180deg);
    }

    /* The dropdown panel is always light, whatever the header colour. */
    .desk-nav__sub {
      --color-focus: var(--color-link);
      position: absolute;
      top: calc(100% + 0.6rem);
      left: 0;
      min-width: 19rem;
      padding: var(--space-2xs);
      list-style: none;
      background: var(--color-bg);
      color: var(--color-ink);
      border: 1px solid var(--color-line);
      border-radius: var(--radius);
      box-shadow: var(--shadow-m);
    }

    :global(html.js) .desk-nav__sub:not([data-open]) {
      display: none;
    }

    /* Without JS: reveal on hover/focus so the services are still reachable. */
    :global(html:not(.js)) .desk-nav__item--has-sub:not(:hover, :focus-within) .desk-nav__sub {
      display: none;
    }

    .desk-nav__sub a {
      display: flex;
      align-items: center;
      gap: 0.4em;
      min-height: 2.75rem;
      padding-inline: var(--space-xs);
      color: inherit;
      text-decoration: none;
      border-radius: var(--radius-s);
    }

    .desk-nav__sub a:hover,
    .desk-nav__sub a[aria-current='page'] {
      background: var(--color-bg-alt);
    }

    .desk-nav__group + .desk-nav__group {
      margin-top: var(--space-2xs);
      padding-top: var(--space-2xs);
      border-top: 1px solid var(--color-line);
    }

    .desk-nav__group-label {
      display: block;
      padding: var(--space-2xs) var(--space-xs) var(--space-3xs);
      font-family: var(--font-display);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--color-ink-muted);
    }

    .desk-nav__sub-all {
      margin-top: var(--space-3xs);
      padding-top: var(--space-3xs);
      border-top: 1px solid var(--color-line);
    }

    .desk-nav__sub-all a {
      font-weight: 650;
    }

    .site-header__call {
      padding-inline: 0.75rem;
    }
  }

  /* Small laptops: a smaller logo and less space between items, so the menu and both buttons
     fit on one line. */
  @media (min-width: 62em) and (max-width: 69.99em) {
    .site-header__bar {
      gap: var(--space-s);
    }

    .site-header__logo {
      width: 8.5rem;
    }

    .desk-nav__item > a {
      padding-left: 0.6rem;
    }

    .desk-nav__item:not(.desk-nav__item--has-sub) > a {
      padding-right: 0.6rem;
    }
  }

  /* Show the phone number beside the icon once there's room. */
  @media (min-width: 80em) {
    .site-header__call-text {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip-path: none;
    }
  }
</style>
