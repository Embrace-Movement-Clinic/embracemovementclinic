---
// Contact & visit (old URL /contact-us-1). Text in src/content/pages/contact.md (edited on /admin).
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import LocationSection from '../components/LocationSection.astro';
import ClosureNote from '../components/ClosureNote.astro';
import Icon from '../components/Icon.astro';
import Link from '../components/Link.astro';
import EmailAddress from '../components/EmailAddress.astro';
import { site, fullAddress } from '../data/site';
import { clinicNode } from '../data/schema';

const pageEntry = await getEntry('contactPage', 'contact');
if (!pageEntry) throw new Error('Missing src/content/pages/contact.md');
const page = pageEntry.data;

// Booking online comes first and is the one filled card: it's the quickest way to an appointment.
const ways = [
  { icon: 'calendar', title: 'Book online', text: 'Booking portal', href: site.booking.url, note: page.bookNote, primary: true },
  { icon: 'phone', title: 'Call', text: site.phone.display, href: site.phone.href, note: page.callNote, primary: false },
  { icon: 'message', title: 'Text', text: site.phone.display, href: site.phone.smsHref, note: page.textNote, primary: false },
  { icon: 'mail', title: 'Email', text: site.email.address, href: site.email.href, note: page.emailNote, primary: false },
] as const;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  url: new URL('/contact', site.url).href,
  name: `Contact ${site.name}`,
  mainEntity: clinicNode(),
};
---

<BaseLayout
  title={`Contact us in ${site.address.suburb}`}
  description={`Call, text or email ${site.name}, or find us at ${fullAddress}. Directions, parking and hours.`}
  jsonLd={jsonLd}
>
  <PageHero
    crumbs={[{ label: 'Contact' }]}
    title="Get in touch"
    lede={page.intro}
  />

  <section class="section" aria-labelledby="ways-h">
    <div class="wrap">
      <h2 id="ways-h" class="visually-hidden">Ways to contact us</h2>
      <ClosureNote />
      <ul class="ways" role="list">
        {
          ways.map((w) => (
            <li>
              <Link class:list={['way', 'panel', 'hover-card', { 'way--primary on-brand': w.primary }]} href={w.href}>
                <Icon name={w.icon} size={26} />
                <span class="way__title">{w.title}</span>
                <span class:list={['way__text', { 'way__text--long': w.text.includes('@') }]}>
                  {w.text.includes('@') ? <EmailAddress address={w.text} /> : <span class="nowrap">{w.text}</span>}
                </span>
                <span class="way__note">{w.note}</span>
              </Link>
            </li>
          ))
        }
      </ul>
      <p class="before">
        First time? Read <a href="/patient-information">patient information</a> for booking, cancellations and what to expect.
      </p>
    </div>
  </section>

  <LocationSection title="Find the clinic" />
</BaseLayout>

<style>
  .wrap > :global(.closure) {
    margin-bottom: var(--space-l);
  }

  /* Two by two, so the email address fits on one line and no card sits alone on a row. */
  .ways {
    display: grid;
    gap: var(--space-s);
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 40em) {
    .ways {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 56em) {
    .way .way__text--long {
      white-space: nowrap;
    }

    /* The line-break hint after "@" is only for narrower screens. */
    .way__text--long :global(wbr) {
      display: none;
    }
  }

  /* Small laptops: a little smaller, so the address still fits on one line. */
  @media (min-width: 56em) and (max-width: 61.99em) {
    .way .way__text--long {
      font-size: var(--step--1);
    }
  }

  .way {
    display: grid;
    align-content: start;
    gap: var(--space-3xs);
    height: 100%;
    color: var(--color-ink);
    text-decoration: none;
  }

  .way :global(svg) {
    margin-bottom: var(--space-xs);
    color: var(--color-icon);
  }

  /* The one filled card. */
  .way--primary {
    border-color: var(--color-brand);
    background: var(--color-brand);
    color: var(--color-on-brand);
  }

  .way--primary :global(svg) {
    color: var(--color-accent-on-brand);
  }

  .way__title {
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: var(--weight-bold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .way__text {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: var(--weight-semibold);
    overflow-wrap: break-word;
  }

  .way__text--long {
    font-size: var(--step-0);
  }

  .way:hover .way__text {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .way__note {
    color: var(--color-ink-muted);
    font-size: var(--step--1);
  }

  .before {
    margin-top: var(--space-l);
  }
</style>
