---
// Design tools only (see src/data/build.ts): shows while a palette preview from /palette is active.
// Hidden unless <html data-preview> is set by the preview script in BaseLayout.
import { darks, accents } from '../data/palette';
import previewBarScript from '../scripts/inline/preview-bar.js?raw';

const names = Object.fromEntries([
  ...Object.entries(darks).map(([k, v]) => [k, v.label]),
  ...Object.entries(accents).map(([k, v]) => [k, v.label]),
]);
---

<div class="preview-bar" role="region" aria-label="Palette preview" data-preview-bar data-names={JSON.stringify(names)} hidden>
  <span>Previewing palette: <strong data-preview-name></strong></span>
  <a href="/palette">Change</a>
  <a href="?palette=off" data-preview-exit>Exit preview</a>
</div>

<script is:inline set:html={previewBarScript} />

<style>
  .preview-bar {
    position: fixed;
    left: var(--space-s);
    bottom: var(--space-s);
    z-index: 90;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) var(--space-s);
    max-width: calc(100vw - 2 * var(--space-s));
    padding: var(--space-xs) var(--space-s);
    border-radius: var(--radius);
    background: #161a18;
    color: #fff;
    font-size: var(--step--1);
    box-shadow: var(--shadow-m);
  }

  .preview-bar[hidden] {
    display: none;
  }

  .preview-bar a {
    color: #fff;
    font-weight: var(--weight-semibold);
  }

  .preview-bar a:focus-visible {
    outline-color: #fff;
  }
</style>
