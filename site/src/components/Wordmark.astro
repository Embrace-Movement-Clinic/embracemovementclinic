---
// The "embrace / MOVEMENT CLINIC" wordmark, from the designer's original vector (assets/brand/logo-wordmark-colour-original.svg, supplied 13 Nov 2026).
// Two parts, data-part="top" ("embrace") and "bottom" ("MOVEMENT CLINIC"), so the header can colour them separately.
// It's drawn in currentColor, so it takes the colour of whatever it sits in.
// Decorative here: give the surrounding link or element an accessible name.
import svg from '../assets/brand/wordmark.svg?raw';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const markup = svg.replace('<svg', '<svg aria-hidden="true" focusable="false" width="100%" height="100%"');
---

<span class:list={['wordmark', className]} set:html={markup} />

<style>
  .wordmark {
    display: block;
    aspect-ratio: 678.2 / 165.5;
    line-height: 0;
  }
</style>
