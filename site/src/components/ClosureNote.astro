---
// Inline note repeating the site-wide notice, for pages where it matters most
// (booking, contact, the timetable). Hidden automatically when the notice is off or has expired.
import Note from './Note.astro';
import { site } from '../data/site';

const { notice } = site;
---

{
  notice.active && (
    <Note as="aside" class="closure" aria-label="Clinic notice" data-hide-after={notice.until || undefined}>
      <strong>{notice.message}</strong> {notice.link && <a href={notice.link.href}>{notice.link.label}</a>}
    </Note>
  )
}

<style>
  :global(.closure a) {
    font-weight: var(--weight-semibold);
  }
</style>
