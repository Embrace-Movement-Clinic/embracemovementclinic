---
// A news post, laid out like the rest of the site: the page header, then one band per section
// (alternating white and mist, like Patient information), each headed by its icon. A section's
// photos or side panel sit beside its text on wide screens; without them the heading sits on the
// left and the text on the right, so the page uses its full width. A highlighted section is a
// petrol card, for the main call to action. A simple post (text only, in the Markdown body) is
// shown as one band, with its photos beside it. When a post is shared (e.g. the link in a text
// message), its preview shows the clinic's logo card (public/og-default.png), not one of its photos.
// A section set to "Also show: Class timetable" spans the full width, with the same timetable as
// the Pilates page under its text (from policies.json), so the two never disagree.
// Data: src/content/news (edited on /admin, News). Section text: basic formatting, src/data/markdown.ts.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import Photo from '../../components/Photo.astro';
import Icon, { type IconName } from '../../components/Icon.astro';
import Button from '../../components/Button.astro';
import Note from '../../components/Note.astro';
import BookingBand from '../../components/BookingBand.astro';
import Timetable from '../../components/Timetable.astro';
import Todo from '../../components/Todo.astro';
import { timetable, timetableFrom } from '../../data/policies';
import { site } from '../../data/site';
import { clinicRef } from '../../data/schema';
import { renderText } from '../../data/markdown';

export async function getStaticPaths() {
  const posts = await getCollection('news');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'news'>;
}

const { post } = Astro.props;
const d = post.data;
const { Content } = await render(post);
const hasBody = Boolean(post.body?.trim());

// "…see Patient information." → link that phrase rather than repeating it after the note.
const noteParts = d.archivedNote ? d.archivedNote.split('Patient information') : [];

// Anchor for each section (e.g. /news/…#book-in-now), so a text message can link straight to it.
const slug = (t: string) => t.toLowerCase().replace(/&/g, 'and').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const sections = d.sections.map((s, i) => ({
  ...s,
  id: slug(s.heading) || `section-${i + 1}`,
  icon: (s.icon ?? 'info') as IconName,
  html: renderText(s.text),
  asideHtml: renderText(s.aside?.text),
  hasSide: Boolean(s.aside?.text?.trim()) || s.images.length > 0,
}));
const layout = (s: (typeof sections)[number]) => (s.show ? 'sec--wide' : s.hasSide ? 'sec--side' : 'sec--plain');
// Bands alternate white and mist; the simple-post body takes the next one.
const alt = (i: number) => i % 2 === 1;

const ratio = (img: { src: { width: number; height: number } }) => (img.src.height > img.src.width ? '4 / 5' : '4 / 3');
const photoSizes = (n: number) => `(min-width: 56em) ${n > 1 ? 20 : 34}vw, ${n > 1 ? 50 : 100}vw`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.summary,
  datePublished: d.date.toISOString().slice(0, 10),
  url: new URL(`/news/${post.id}`, site.url).href,
  publisher: clinicRef,
};
const month = d.date.toLocaleDateString('en-AU', { month: 'long', year: 'numeric', timeZone: 'Australia/Brisbane' });
---

<BaseLayout
  noindex
  title={d.title}
  description={d.summary}
  ogType="article"
  jsonLd={jsonLd}
>
  <PageHero crumbs={[{ label: 'News', href: '/news' }, { label: d.title }]} eyebrow={`Clinic news · ${month}`} title={d.title} lede={d.summary}>
    <Fragment slot="actions">
      <Button href={site.booking.url} icon="calendar" size="l">Book now</Button>
      <Button href={site.phone.href} variant="secondary" size="l" icon="phone">
        <span class="visually-hidden">Call </span>{site.phone.display}
      </Button>
    </Fragment>
  </PageHero>

  {
    d.archivedNote && (
      <div class="band band--first">
        <div class="wrap">
          <Note as="div">
            {noteParts.length > 1 ? (
              noteParts.map((part, i) => (
                <>
                  {part}
                  {i < noteParts.length - 1 && <a href="/patient-information">Patient information</a>}
                </>
              ))
            ) : (
              <>
                {d.archivedNote} <a href="/patient-information">Patient information</a>
              </>
            )}
          </Note>
        </div>
      </div>
    )
  }

  {
    sections.map((s, i) => (
      <section id={s.id} class:list={['band', { 'band--alt': alt(i) }]} aria-labelledby={`${s.id}-h`}>
        <div class="wrap">
          {s.highlight ? (
            <div class="feature on-brand">
              <span class="feature__mark" aria-hidden="true">
                <Icon name={s.icon} size={170} />
              </span>
              <div class="feature__text">
                <h2 id={`${s.id}-h`} class="h3 feature__title">
                  <Icon name={s.icon} size={26} />
                  <span>{s.heading}</span>
                </h2>
                {s.html && <div class="rich" set:html={s.html} />}
              </div>
              {s.buttons.length > 0 && (
                <div class="feature__actions">
                  {s.buttons.map((b) => (
                    <Button href={b.link} variant={b.style === 'secondary' ? 'secondary' : undefined} size="l">
                      {b.label}
                    </Button>
                  ))}
                </div>
              )}
            </div>
          ) : (
            <div class:list={['sec', layout(s)]}>
              <SectionHead id={`${s.id}-h`} icon={s.icon} title={s.heading} size="s" class="sec__head" />
              <div class="sec__body">
                {s.html && <div class="rich" set:html={s.html} />}
                {s.show === 'timetable' &&
                  (timetable ? (
                    <Timetable days={timetable} from={timetableFrom} />
                  ) : (
                    <Todo as="div" live="Call or text us for current class times.">
                      class timetable (Policies and timetable on /admin)
                    </Todo>
                  ))}
                {s.buttons.length > 0 && (
                  <div class="sec__actions">
                    {s.buttons.map((b) => (
                      <Button href={b.link} variant={b.style === 'secondary' ? 'secondary' : undefined}>
                        {b.label}
                      </Button>
                    ))}
                  </div>
                )}
              </div>
              {s.hasSide && (
                <div class="sec__side">
                  {s.asideHtml && (
                    <div class="panel side-panel">
                      {s.aside?.heading && <h3 class="h4">{s.aside.heading}</h3>}
                      <div class="rich" set:html={s.asideHtml} />
                    </div>
                  )}
                  {s.images.length > 0 && (
                    <div class="photos" style={`--n: ${Math.min(s.images.length, 2)}`}>
                      {s.images.map((img) => (
                        <Photo src={img.src} alt={img.alt} position={img.position} ratio={ratio(img)} sizes={photoSizes(s.images.length)} />
                      ))}
                    </div>
                  )}
                </div>
              )}
            </div>
          )}
        </div>
      </section>
    ))
  }

  {
    hasBody && (
      <section class:list={['band', { 'band--alt': alt(sections.length) }]} aria-label="Post">
        <div class:list={['wrap', 'sec', d.images.length ? 'sec--side' : 'sec--text']}>
          <div class="sec__body rich">
            <Content />
          </div>
          {d.images.length > 0 && (
            <div class="sec__side">
              <div class="photos" style={`--n: ${Math.min(d.images.length, 2)}`}>
                {d.images.map((img) => (
                  <Photo src={img.src} alt={img.alt} position={img.position} ratio={ratio(img)} sizes={photoSizes(d.images.length)} />
                ))}
              </div>
            </div>
          )}
        </div>
      </section>
    )
  }

  <BookingBand />
</BaseLayout>

<style>
  .band {
    padding-block: var(--space-xl);
  }

  .band--first {
    padding-block: var(--space-m) 0;
  }

  .band--alt {
    background: var(--color-bg-alt);
  }

  /* A section: heading, text (with its buttons) and, on wide screens, its side panel or photos. */
  .sec {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-m);
    align-items: start;
  }

  .sec__body {
    display: grid;
    gap: var(--space-m);
    max-width: 46rem;
  }

  /* A section showing the timetable: heading above, then text and timetable across the full width. */
  .sec--wide .sec__body {
    max-width: none;
  }

  .sec--wide .sec__body > .rich {
    max-width: 46rem;
  }

  /* On a mist band the timetable's own mist panel would vanish: white panel, mist day labels. */
  .band--alt :global(.board) {
    background: var(--color-bg);
  }

  .band--alt :global(.day__name) {
    background: var(--color-bg-alt);
  }

  .sec__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  @media (min-width: 56em) {
    /* With photos or a side panel: heading and text on the left, the photos beside them. */
    /* The second row takes any extra height a tall photo brings, so the text stays under its heading. */
    .sec--side {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      column-gap: var(--space-xl);
    }

    .sec--side :global(.sec__head) {
      grid-column: 1;
    }

    .sec--side .sec__body {
      grid-column: 1;
    }

    .sec--side .sec__side {
      grid-column: 2;
      grid-row: 1 / span 2;
    }

    /* Text only: the heading on the left, the text across the rest of the page. */
    .sec--plain {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      column-gap: var(--space-xl);
    }

    .sec--plain :global(.section-head) {
      margin-bottom: 0;
    }
  }

  /* Text from /admin: paragraphs, and lists as a ruled panel (e.g. opening hours). */
  .rich {
    display: grid;
    gap: var(--space-s);
    font-size: var(--step-1);
    line-height: 1.6;
  }

  .rich :global(ul),
  .rich :global(ol) {
    margin: 0;
    padding: var(--space-2xs) var(--space-m);
    list-style: none;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-l);
    background: var(--color-bg);
    font-size: var(--step-0);
  }

  .band:not(.band--alt) .sec .rich :global(ul),
  .band:not(.band--alt) .sec .rich :global(ol) {
    background: var(--color-bg-alt);
    border-color: transparent;
  }

  .rich :global(li) {
    padding-block: 0.6em;
  }

  .rich :global(li + li) {
    border-top: 1px solid var(--color-line);
  }

  /* "Monday: 6am – 1pm": a list item starting with a bold label lines up like a timetable, its
     value wrapping in its own column. */
  .rich :global(li:has(> strong:first-child)) {
    display: grid;
    grid-template-columns: minmax(0, 7.5em) minmax(0, 1fr);
    column-gap: 0.5em;
  }

  .side-panel {
    display: grid;
    gap: var(--space-s);
  }

  /* Photos: one fills the side column; two sit side by side. */
  .sec__side {
    display: grid;
    gap: var(--space-m);
  }

  .photos {
    display: grid;
    gap: var(--space-s);
    grid-template-columns: repeat(var(--n, 1), minmax(0, 1fr));
  }

  .photos :global(.photo) {
    border-radius: var(--radius-l);
  }

  /* A single photo stays a sensible size beside the text, rather than filling the whole column. */
  .photos[style*='--n: 1'] {
    max-width: 24rem;
  }

  @media (max-width: 55.99em) {
    .photos {
      max-width: 34rem;
    }
  }

  /* The highlighted section: a petrol card, its text on the left and buttons on the right. */
  .feature {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-m);
    padding: var(--space-l) var(--space-m);
    border-radius: var(--radius-l);
    background: var(--color-brand);
    color: var(--color-on-brand);
  }

  @media (min-width: 40em) {
    .feature {
      padding: var(--space-xl) var(--space-l);
    }
  }

  /* Wide screens: the buttons take the width their labels need, on one line each. */
  @media (min-width: 56em) {
    .feature {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      column-gap: var(--space-xl);
    }

  }

  .feature__mark {
    position: absolute;
    right: -1.75rem;
    bottom: -1.75rem;
    color: var(--color-accent-on-brand);
    opacity: 0.12;
    pointer-events: none;
  }

  .feature__text {
    position: relative;
    display: grid;
    gap: var(--space-s);
  }

  .feature__title {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    color: inherit;
  }

  .feature__title :global(svg) {
    color: var(--color-accent-on-brand);
  }

  .feature .rich :global(a) {
    color: inherit;
  }

  .feature__actions {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  /* One line each, except with very large text (global.css lets buttons wrap there). */
  @media (min-width: 18em) {
    .feature__actions :global(.btn) {
      white-space: nowrap;
    }
  }

  /* Phones: a slightly smaller button label, so "Text Nicole on 0434 686 261" fits on one line. */
  @media (max-width: 39.99em) {
    .feature__actions :global(.btn) {
      font-size: var(--step-0);
      padding-inline: 1.1em;
    }
  }

  @media (min-width: 56em) {
    .feature__actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
