---
// One-on-one service pages (physiotherapy, pelvic health, vestibular, exercise therapy).
// Same structure for every service: hero → is this for you → what to expect →
// treatment → who you'll see → good to know → related → book. Pilates has its own page.
import { getCollection, getEntries, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import IconBadge from '../components/IconBadge.astro';
import SectionHead from '../components/SectionHead.astro';
import OnPageNav from '../components/OnPageNav.astro';
import Note from '../components/Note.astro';
import Steps from '../components/Steps.astro';
import PractitionerList from '../components/PractitionerList.astro';
import ServiceCard from '../components/ServiceCard.astro';
import BookingBand from '../components/BookingBand.astro';
import { site } from '../data/site';
import { serviceNode } from '../data/schema';

export async function getStaticPaths() {
  const services = await getCollection('services', (s) => s.data.kind === 'appointment');
  return services.map((service) => ({ params: { service: service.id }, props: { service } }));
}

interface Props {
  service: CollectionEntry<'services'>;
}

const { service } = Astro.props;
const d = service.data;
const { Content } = await render(service);
const hasBody = Boolean(service.body?.trim());
const related = (await getEntries(d.related)) as CollectionEntry<'services'>[];
const team = (await getEntries(d.practitioners)) as CollectionEntry<'team'>[];
const names = team.map((t) => t.data.firstName);
// One practitioner with their own booking link (e.g. Pelvic Health → Nicole): book straight with them.
const solo = team.length === 1 && team[0].data.bookingUrl ? team[0] : undefined;
const bookUrl = solo?.data.bookingUrl ?? site.booking.url;
const bookLabel = solo ? `Book with ${solo.data.firstName}` : 'Book now';
const seeLine = names.length > 1 ? `${names.slice(0, -1).join(', ')} or ${names.at(-1)}` : names[0];

// Conditions as tiles: those with a description first, then the short ones.
const conditions = [...d.forYou.items.filter((i) => i.detail), ...d.forYou.items.filter((i) => !i.detail)];
// Columns on wide screens chosen so the last row isn't left with a single tile (6 → 3 + 3, 7 → 4 + 3, 8 → 4 + 4).
const colsFor = (n: number) => (n <= 4 ? Math.max(n, 2) : n % 4 === 0 || n % 4 === 3 ? 4 : 3);
const hasExpect = Boolean(d.expect.text || d.expect.steps?.length);
const jsonLd = serviceNode({
  name: d.title,
  description: d.seoDescription,
  path: `/${service.id}`,
  image: d.image ? new URL(`/og/services/${service.id}.jpg`, site.url).href : undefined,
});
const sections = [
  { id: 'for-you', label: d.forYou.heading === 'Is this for you?' ? 'Is this for you?' : 'Conditions' },
  ...(hasExpect ? [{ id: 'expect', label: 'What to expect' }] : []),
  ...(d.treatments ? [{ id: 'treatment', label: 'Treatment' }] : []),
  { id: 'who', label: 'Who you’ll see' },
];
---

<BaseLayout title={d.seoTitle} description={d.seoDescription} shareImage={d.image ? `/og/services/${service.id}.jpg` : undefined} imageAlt={d.imageAlt} jsonLd={jsonLd}>
  <PageHero crumbs={[{ label: 'Services', href: '/services' }, { label: d.title }]} eyebrow="One-on-one appointments" title={d.title} lede={d.lede}>
    <p class="see">
      <Icon name="user" size={18} /> You’ll see {seeLine}
    </p>
    {
      d.notice && (
        <p class="service-notice">
          <Icon name="info" size={18} />
          <span>{d.notice}</span>
        </p>
      )
    }
    <Fragment slot="actions">
      <Button href={bookUrl} icon="calendar" size="l">{bookLabel}</Button>
      <Button href={site.phone.href} variant="secondary" size="l" icon="phone">
        <span class="visually-hidden">Call </span>{site.phone.display}
      </Button>
    </Fragment>
    <Photo slot="aside" src={d.image} alt={d.imageAlt ?? ''} note={d.imageNote} position={d.imagePosition} ratio="4 / 3" loading="eager" sizes="(min-width: 56em) 45vw, 100vw" />
  </PageHero>

  <OnPageNav links={sections.map((s) => ({ href: `#${s.id}`, label: s.label }))} />

  {
    hasBody && (
      <section class="section section--tight" aria-label="About">
        <div class="wrap prose about">
          <Content />
        </div>
      </section>
    )
  }

  <!-- Is this for you? -->
  <section class="section" id="for-you" aria-labelledby="for-you-h">
    <div class="wrap">
      <SectionHead id="for-you-h" icon="heart" title={d.forYou.heading} intro={d.forYou.intro ? `${d.forYou.intro}:` : undefined} />
      <ul class="tiles" role="list" style={`--cols: ${colsFor(conditions.length)}`}>
        {
          conditions.map((i) => (
            <li class="tile panel panel--soft">
              <IconBadge name="check" tone="plain" />
              <p class="tile__name">{i.name}</p>
              {i.detail && <p class="tile__detail">{i.detail}</p>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- What to expect -->
  {
    hasExpect && (
      <section class="section section--alt" id="expect" aria-labelledby="expect-h">
        <div class="wrap expect">
          <div class="expect__head">
            <IconBadge name="calendar" size="l" />
            <p class="eyebrow">Your first appointment</p>
            <h2 id="expect-h">What to expect</h2>
          </div>
          <div class="expect__body">
            {d.expect.text && <p class="expect__text">{d.expect.text}</p>}
            {d.expect.steps && <Steps steps={d.expect.steps} />}
          </div>
        </div>
      </section>
    )
  }

  <!-- Treatment -->
  {
    d.treatments && (
      <section class="section" id="treatment" aria-labelledby="treatment-h">
        <div class="wrap">
          <SectionHead id="treatment-h" icon="activity" title={d.treatments.heading} />
          <ul class="treatments" role="list" style={`--cols: ${Math.min(colsFor(d.treatments.items.length), 3)}`}>
            {d.treatments.items.map((t) => (
              <li class="panel">
                <h3 class="h4">{t.name}</h3>
                {t.detail && <p>{t.detail}</p>}
              </li>
            ))}
          </ul>
          {d.goodToKnow.length > 0 && (
            <ul class="good" role="list">
              {d.goodToKnow.map((g) => (
                <Note as="li">
                  <strong>{g.name}.</strong> {g.detail}
                </Note>
              ))}
            </ul>
          )}
        </div>
      </section>
    )
  }

  <!-- Who you'll see -->
  <section class="section section--alt" id="who" aria-labelledby="who-h">
    <div class="wrap">
      <SectionHead id="who-h" icon="users" title="Who you’ll see" intro={d.practitionersNote} />
      <PractitionerList refs={d.practitioners} />
    </div>
  </section>

  <!-- Practical links -->
  <section class="section section--tight" aria-labelledby="practical-h">
    <div class="wrap">
      <h2 id="practical-h" class="h3">Good to know</h2>
      <ul class="practical" role="list">
        <li>
          <a class="hover-tile" href="/patient-information#fees">
            <IconBadge name="card" />
            <span><strong>Fees and rebates</strong> What appointments cost and what you can claim</span>
          </a>
        </li>
        <li>
          <a class="hover-tile" href="/patient-information#cancellations">
            <IconBadge name="clock" />
            <span><strong>Cancellations</strong> Our cancellation policy</span>
          </a>
        </li>
        <li>
          <a class="hover-tile" href="/contact">
            <IconBadge name="map-pin" />
            <span><strong>Getting here</strong> {site.address.street}, {site.address.suburb}</span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="section section--alt" aria-labelledby="related-h">
        <div class="wrap">
          <SectionHead id="related-h" title="You might also need" />
          <ul class="related" role="list" style={`--n: ${Math.min(related.length, 3)}`}>
            {related.map((r) => (
              <li>
                <ServiceCard service={r} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <BookingBand
    text={`Book online, or call us on ${site.phone.display} if you’re not sure which appointment you need.`}
    bookLabel={bookLabel}
    bookUrl={bookUrl}
  />
</BaseLayout>

<style>
  .see {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-weight: var(--weight-semibold);
  }

  .about {
    font-size: var(--step-1);
  }

  /* Conditions: a pale teal tile each, in as many columns as suit the number of tiles. */
  .tiles {
    display: grid;
    gap: var(--space-s);
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 40em) {
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 62em) {
    .tiles {
      grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr));
    }
  }

  .tile {
    display: grid;
    gap: var(--space-3xs);
    align-content: start;
  }

  .tile :global(.icon-badge) {
    margin-bottom: var(--space-2xs);
  }

  .tile__name {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: var(--weight-semibold);
    line-height: 1.25;
  }

  .tile__detail {
    color: var(--color-ink-muted);
  }

  /* What to expect */
  .expect {
    display: grid;
    gap: var(--space-l);
  }

  @media (min-width: 56em) {
    .expect {
      grid-template-columns: 1fr 2fr;
      gap: var(--space-xl);
    }
  }

  .expect__head {
    display: grid;
    gap: var(--space-xs);
    align-content: start;
    justify-items: start;
  }

  .expect__head :global(.icon-badge) {
    margin-bottom: var(--space-2xs);
  }

  .expect__body {
    display: grid;
    gap: var(--space-l);
  }

  .expect__text {
    font-size: var(--step-1);
    line-height: 1.6;
    max-width: var(--measure);
  }

  /* Treatment */
  .service-notice {
    display: flex;
    gap: var(--space-2xs);
    align-items: start;
    max-width: 36rem;
    margin-top: var(--space-s);
    padding: var(--space-xs) var(--space-s);
    border-radius: var(--radius);
    background: var(--color-accent-soft);
    color: var(--color-ink);
    font-weight: var(--weight-semibold);
  }

  .service-notice :global(svg) {
    flex-shrink: 0;
    margin-top: 0.15em;
    color: var(--color-icon);
  }

  /* Treatment: a card each, with a teal rule across the top. */
  .treatments {
    display: grid;
    gap: var(--space-s);
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 40em) {
    .treatments {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 62em) {
    .treatments {
      grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr));
    }
  }

  .treatments li {
    display: grid;
    align-content: start;
    gap: var(--space-3xs);
  }

  .treatments li::before {
    content: '';
    width: 2.5rem;
    height: 4px;
    margin-bottom: var(--space-xs);
    border-radius: 2px;
    background: var(--color-icon);
  }

  .treatments p {
    color: var(--color-ink-muted);
  }

  .good {
    display: grid;
    gap: var(--space-xs);
    margin-top: var(--space-l);
  }

  /* Practical links: bordered tiles, as on Patient information. */
  .practical {
    display: grid;
    gap: var(--space-s);
    margin-top: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }

  .practical a {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-s);
    align-items: center;
    height: 100%;
    padding: var(--space-s) var(--space-m);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-l);
    color: var(--color-ink);
    text-decoration: none;
  }

  .practical a > span {
    display: grid;
    gap: var(--space-3xs);
    color: var(--color-ink-muted);
  }

  .practical strong {
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: var(--step-0);
  }

  /* As many columns as cards (up to 3), so two related services don't leave an empty column. */
  .related {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: 1fr;
  }

  @media (min-width: 40em) {
    .related {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 62em) {
    .related {
      grid-template-columns: repeat(var(--n, 3), 1fr);
    }
  }
</style>
