---
// Patient information: practical facts gathered from the old newsletters and pages,
// in one evergreen place. Facts live in src/data/policies.json and src/data/clinic.json;
// this page's own text in src/content/pages/patient-information.md (edited on /admin).
// Layout: an icon grid to jump to each topic, then one band per topic (alternating white and
// mist), each headed by its icon, so the page scans as a set of short, visual sections.
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import IconBadge from '../components/IconBadge.astro';
import IconTile from '../components/IconTile.astro';
import SectionHead from '../components/SectionHead.astro';
import BookingTip from '../components/BookingTip.astro';
import EmailAddress from '../components/EmailAddress.astro';
import FeeGroups from '../components/FeeGroups.astro';
import Photo from '../components/Photo.astro';
import Todo from '../components/Todo.astro';
import ClosureNote from '../components/ClosureNote.astro';
import CancellationCallout from '../components/CancellationCallout.astro';
import BookingBand from '../components/BookingBand.astro';
import { site, fullAddress } from '../data/site';
import { classFacts, studioEtiquette, booking } from '../data/policies';

const pageEntry = await getEntry('patientInfo', 'patient-information');
const teamEntry = await getEntry('teamPage', 'team');
if (!pageEntry || !teamEntry) throw new Error('Missing a file in src/content/pages');
const p = pageEntry.data;
const jeff = teamEntry.data.jeff;

const sections: { id: string; label: string; icon: IconName }[] = [
  { id: 'booking', label: 'Booking', icon: 'calendar' },
  { id: 'first-visit', label: 'Your first visit', icon: 'user' },
  { id: 'cancellations', label: 'Cancellations', icon: 'clock' },
  { id: 'fees', label: 'Fees and rebates', icon: 'card' },
  { id: 'classes', label: 'Classes', icon: 'users' },
  { id: 'at-the-clinic', label: 'At the clinic', icon: 'map-pin' },
  { id: 'privacy', label: 'Your privacy', icon: 'shield' },
];
const sec = Object.fromEntries(sections.map((s) => [s.id, s]));

// Stop short facts breaking at a dash or hyphen ("4–" / "5 people", "pre-" / "class") with word joiners.
const keepTogether = (t: string) => t.replace(/(\w)([–-])(\w)/g, '$1\u2060$2\u2060$3');

// Class facts are edited on /admin, so pick each tile's icon from its label rather than its position.
const factIcon = (label: string): IconName =>
  /size|people/i.test(label) ? 'users' : /length|long|minute|time/i.test(label) ? 'clock' : /health|fund|rebate|claim/i.test(label) ? 'card' : 'check';
---

<BaseLayout
  title={`Patient information | ${site.name}, ${site.address.suburb}`}
  description="Booking, your first visit, cancellations, fees and rebates, class information and what to know before you visit Embrace Movement Clinic in McDowall."
>
  <PageHero
    crumbs={[{ label: 'Patient information' }]}
    eyebrow="Before you visit"
    title="Patient information"
    lede={p.intro}
  />

  <div class="band band--first">
    <div class="wrap jump-wrap">
      <ClosureNote />
      <nav aria-label="On this page">
        <ul class="jump" role="list">
          {
            sections.map((s) => (
              <li>
                <IconTile href={`#${s.id}`} icon={s.icon}>
                  {s.label}
                </IconTile>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>

  <section id="booking" aria-labelledby="booking-h" class="band">
    <div class="wrap">
      <SectionHead id="booking-h" icon={sec.booking.icon} title="Booking" size="s" />
      <div class="ways">
        <div class="way way--main on-brand">
          <span class="way__mark" aria-hidden="true"><Icon name="calendar" size={150} /></span>
          <Icon name="calendar" size={26} />
          <h3 class="h4">Book online</h3>
          <p>Book appointments, pre-class assessments and classes through our online booking portal.</p>
          <div class="way__actions">
            <Button href={site.booking.url} size="s">Book now</Button>
            {booking.portalUrl && (
              <Button href={booking.portalUrl} variant="secondary" size="s">
                Patient portal
              </Button>
            )}
          </div>
        </div>
        <div class="way">
          <Icon name="phone" size={26} />
          <h3 class="h4">Call or text</h3>
          <p>
            Call <a href={site.phone.href}>{site.phone.display}</a>. {booking.waitlistText}{' '}
            <a href={site.phone.smsHref}>{site.phone.display}</a>.
          </p>
        </div>
        <div class="way">
          <Icon name="mail" size={26} />
          <h3 class="h4">Email</h3>
          <p><a href={site.email.href} class="email"><EmailAddress address={site.email.address} /></a></p>
        </div>
      </div>
      <BookingTip class="booking__tip" />
    </div>
  </section>

  <section id="first-visit" aria-labelledby="first-h" class="band band--alt">
    <div class="wrap">
      <SectionHead id="first-h" icon={sec['first-visit'].icon} title="Your first visit" size="s" />
      <div class="split">
        <div class="prose">
          {p.firstVisit[0] && <p class="lede-s">{p.firstVisit[0]}</p>}
          {p.firstVisit.slice(1).map((para) => <p>{para}</p>)}
          <p>
            Each service page explains what to expect in more detail. See{' '}
            <a href="/services">all services</a>.
          </p>
        </div>
        <div class="panel">
          <h3 class="h4">What to bring</h3>
          {
            p.whatToBring.length > 0 ? (
              <ul class="icon-list" role="list">
                {p.whatToBring.map((item) => (
                  <li>
                    <Icon name="check" size={18} />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            ) : (
              <Todo as="div">what clients should bring to a first appointment (for example a referral, health fund card or comfortable clothing)</Todo>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <section id="cancellations" aria-labelledby="cancel-h" class="band">
    <div class="wrap">
      <SectionHead id="cancel-h" icon={sec.cancellations.icon} title="Cancellations" size="s" />
      <CancellationCallout />
    </div>
  </section>

  <section id="fees" aria-labelledby="fees-h" class="band band--alt">
    <div class="wrap">
      <SectionHead id="fees-h" icon={sec.fees.icon} title="Fees and rebates" size="s" />
      {
        p.fees.length > 0 ? (
          <FeeGroups fees={p.fees} />
        ) : (
          <Todo as="div">fees for initial and follow-up appointments, pre-class assessments and classes</Todo>
        )
      }

      <h3 class="h3 sub-h">Rebates and funding</h3>
      <div class="pair">
        {
          p.feeNotes.length > 0 && (
            <div class="panel">
              <ul class="icon-list" role="list">
                {p.feeNotes.map((note) => (
                  <li>
                    <Icon name="card" size={18} />
                    <span>{note}</span>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        <div class="panel">
          {
            p.funding.length > 0 ? (
              <ul class="icon-list" role="list">
                {p.funding.map((item) => (
                  <li>
                    <Icon name="shield" size={18} />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            ) : (
              <Todo as="div">whether you accept Medicare (GP care plan) referrals, DVA, NDIS or WorkCover. Add here if so.</Todo>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <section id="classes" aria-labelledby="classes-h" class="band">
    <div class="wrap">
      <SectionHead id="classes-h" icon={sec.classes.icon} title="Classes" size="s" />
      <dl class="stats">
        {
          classFacts.map((f) => (
            <div class:list={['stat', 'panel', 'panel--soft', { 'stat--long': f.value.length > 40 }]}>
              <Icon name={factIcon(f.label)} size={24} />
              <dt>{f.label}</dt>
              <dd>{keepTogether(f.value)}</dd>
            </div>
          ))
        }
      </dl>
      <div class="split">
        <div class="prose">
          <p>{booking.classes}</p>
          <div class="actions">
            <Button href="/pilates#timetable" icon="calendar">See the class timetable</Button>
          </div>
        </div>
        <div class="panel panel--mist">
          <h3 class="h4">What to wear</h3>
          <ul class="icon-list" role="list">
            {
              studioEtiquette.map((e) => (
                <li>
                  <Icon name="check" size={18} />
                  <span>
                    <strong>{/[.?!]$/.test(e.name) ? e.name : `${e.name}.`}</strong> {e.detail}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="at-the-clinic" aria-labelledby="clinic-h" class="band band--alt">
    <div class="wrap">
      <SectionHead id="clinic-h" icon={sec['at-the-clinic'].icon} title="At the clinic" size="s" />
      <div class="split split--even">
        <div class="stack">
          <div class="panel place">
            <Icon name="map-pin" size={24} />
            <div>
              <h3 class="h4">Address</h3>
              <p><a href={site.address.directionsUrl}>{fullAddress}</a></p>
            </div>
          </div>
          <div class="panel place">
            <Icon name="info" size={24} />
            <div>
              <h3 class="h4">Parking</h3>
              <p>{site.parking ?? <Todo>parking details</Todo>}</p>
            </div>
          </div>
          {
            site.access && (
              <div class="panel place">
                <Icon name="info" size={24} />
                <div>
                  <h3 class="h4">Access</h3>
                  <p>{site.access}</p>
                </div>
              </div>
            )
          }
        </div>
        <div class="panel jeff">
          <Photo src={jeff.photo} alt={jeff.photoAlt} position={jeff.photoPosition} ratio="16 / 10" class="jeff__photo" sizes="(min-width: 56em) 36rem, 100vw" />
          <div class="jeff__text">
            <h3 class="h4"><Icon name="paw" size={20} /> {jeff.heading}</h3>
            <p>{[jeff.text, jeff.extra].filter(Boolean).join(' ')}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="privacy" aria-labelledby="privacy-h" class="band">
    <div class="wrap">
      <div class="privacy">
        <IconBadge name={sec.privacy.icon} size="l" />
        <div>
          <h2 id="privacy-h" class="h3">Your privacy</h2>
          <p>{p.privacy}</p>
        </div>
        <Button href="/privacy" variant="secondary" size="s">Read our privacy policy</Button>
      </div>
    </div>
  </section>

  <BookingBand />
</BaseLayout>

<style>
  /* One band per topic, alternating white and mist; tighter than a full .section. */
  .band {
    padding-block: var(--space-xl);
    scroll-margin-top: var(--header-h);
  }

  .band--first {
    padding-block: var(--space-m) 0;
  }

  .band--alt {
    background: var(--color-bg-alt);
  }

  .jump-wrap {
    display: grid;
    gap: var(--space-m);
  }

  /* Jump grid: one icon tile per topic. */
  .jump {
    display: grid;
    gap: var(--space-2xs);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  /* An odd last tile spans the row while there are two columns, so there's no gap. */
  @media (max-width: 55.99em) {
    .jump li:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  /* Four across only once each tile is wide enough for the longest label ("Cancellations"). */
  @media (min-width: 56em) {
    .jump {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 75em) {
    .jump {
      grid-template-columns: repeat(7, minmax(0, 1fr));
    }

    .jump :global(.icon-tile) {
      flex-direction: column;
      justify-content: center;
      min-height: 7.5rem;
      padding: var(--space-xs);
      text-align: center;
    }

    .jump :global(.icon-tile__label) {
      flex: none;
    }
  }

  /* Very narrow screens (320px phones, or 400% zoom): one tile per row, so the longest labels
     ("Cancellations") stay inside their tiles. */
  @media (max-width: 21.99em) {
    .jump {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .panel > h3 {
    margin-bottom: var(--space-s);
  }

  .prose {
    display: grid;
    gap: var(--space-s);
    align-content: start;
    max-width: var(--measure);
  }

  .lede-s {
    font-size: var(--step-1);
  }

  .split {
    display: grid;
    gap: var(--space-m);
  }

  @media (min-width: 56em) {
    .split {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: var(--space-l);
      align-items: start;
    }

    .split--even {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: stretch;
    }
  }

  .stack {
    display: grid;
    gap: var(--space-s);
    align-content: start;
  }

  /* Booking: three ways to book, online first and in petrol. */
  .ways {
    display: grid;
    gap: var(--space-s);
  }

  @media (min-width: 40em) {
    .ways {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .way--main {
      grid-row: span 2;
    }
  }

  @media (min-width: 75em) {
    .ways {
      grid-template-columns: 1.3fr 1fr 1fr;
    }

    .way--main {
      grid-row: auto;
    }
  }

  .way {
    position: relative;
    overflow: hidden;
    display: grid;
    gap: var(--space-xs);
    align-content: start;
    justify-items: start;
    padding: var(--space-m);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-l);
    background: var(--color-bg);
  }

  .way > :global(svg) {
    color: var(--color-icon);
  }

  .way p {
    color: var(--color-ink-muted);
  }

  .way--main {
    border-color: var(--color-brand);
    background: var(--color-brand);
    color: var(--color-on-brand);
  }

  .way--main > :global(svg) {
    color: var(--color-accent-on-brand);
  }

  .way--main p {
    position: relative;
    color: var(--color-on-brand);
  }

  .way__mark {
    position: absolute;
    right: -1.5rem;
    bottom: -1.5rem;
    color: var(--color-accent-on-brand);
    opacity: 0.12;
    pointer-events: none;
  }

  .way__actions {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-top: var(--space-2xs);
  }

  .email {
    overflow-wrap: anywhere;
  }

  :global(.booking__tip) {
    margin-top: var(--space-s);
  }

  .sub-h {
    margin: var(--space-l) 0 var(--space-s);
  }

  .pair {
    display: grid;
    gap: var(--space-s);
  }

  @media (min-width: 56em) {
    .pair {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Classes: the key facts as tiles. */
  .stats {
    display: grid;
    gap: var(--space-s);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-bottom: var(--space-l);
  }

  @media (min-width: 62em) {
    .stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .stat {
    display: grid;
    grid-template-rows: auto auto 1fr;
    gap: var(--space-3xs);
    align-content: start;
  }

  .stat > :global(svg) {
    margin-bottom: var(--space-2xs);
    color: var(--color-icon);
  }

  .stat dt {
    color: var(--color-ink-muted);
    font-size: var(--step--1);
  }

  .stat dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: var(--weight-semibold);
    line-height: 1.25;
  }

  .stat--long dd {
    font-size: var(--step-0);
  }

  @media (max-width: 39.99em) {
    .stat {
      padding: var(--space-s);
    }

    .stat dd {
      font-size: var(--step-0);
    }
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-top: var(--space-2xs);
  }

  /* At the clinic: address and parking beside a Jeff card with his photo. */
  .place {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-s);
  }

  .place > :global(svg) {
    color: var(--color-icon);
  }

  .place h3 {
    margin-bottom: var(--space-3xs);
  }

  .jeff {
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    padding: 0;
  }

  .jeff__text {
    display: grid;
    gap: var(--space-2xs);
    align-content: start;
    padding: var(--space-m);
  }

  .jeff__text h3 {
    display: flex;
    align-items: center;
    gap: 0.4em;
  }

  .jeff__text :global(svg) {
    color: var(--color-icon);
  }

  /* Privacy: one row. */
  .privacy {
    display: grid;
    gap: var(--space-s);
    align-items: center;
    padding: var(--space-m);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-l);
  }

  @media (min-width: 40em) {
    .privacy {
      grid-template-columns: auto 1fr auto;
      gap: var(--space-m);
    }
  }

  .privacy p {
    margin-top: var(--space-3xs);
    color: var(--color-ink-muted);
  }
</style>
