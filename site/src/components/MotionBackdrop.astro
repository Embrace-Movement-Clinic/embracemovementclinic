---
// "Glow": a slow, silent loop of soft light behind a section's content (home hero, light page
// headers, booking band). The files live in site/public/media/motion/ and are drawn by
// motion/glow.py from the site palette.
//
// Usage: add the `has-motion` class to the section and put this first inside it.
//   <section class="on-brand hero curve-bottom has-motion">
//     <MotionBackdrop loop="hero" />
//     …
//
// Behaviour, by design:
// - Nothing downloads until the page has finished loading and the section is near the screen,
//   so the loops never compete with the page's own text, fonts and photos.
// - With "reduce motion" or data saver switched on, no video loads and the section keeps its
//   plain background.
// - Each loop plays by itself, only while it is on screen. There is no control on the section;
//   the footer's "Pause animation" link stops them all (WCAG 2.2.2).
// - The video is hidden from assistive technology: it carries no information.
interface Props {
  /** hero: petrol home hero · light: pale page headers · band: petrol booking band */
  loop: 'hero' | 'light' | 'band';
  /** Which part of the video to keep when it's cropped (CSS object-position). */
  position?: string;
}

const loops = {
  hero: { wide: 'glow-hero', narrow: 'glow-hero-tall', position: '50% 50%', fade: false },
  light: { wide: 'glow-light', narrow: 'glow-light-tall', position: '50% 50%', fade: false },
  // The band sits straight on top of the footer, so its loop fades out towards the bottom edge
  // and the two petrol areas still read as one.
  band: { wide: 'glow-band', narrow: 'glow-band-tall', position: '50% 50%', fade: true },
} as const;

const { loop, position } = Astro.props;
const set = loops[loop];
const base = '/media/motion';
// Matches the site's 56em breakpoint (one-column layouts below it).
const narrow = '(max-width: 55.99em)';
---

<div class:list={['motion', { 'motion--fade': set.fade }]} data-motion aria-hidden="true">
  <video muted loop playsinline preload="none" tabindex="-1" disablepictureinpicture disableremoteplayback style={`object-position: ${position ?? set.position}`}>
    <source data-src={`${base}/${set.narrow}.mp4`} type="video/mp4" media={narrow} />
    <source data-src={`${base}/${set.wide}.mp4`} type="video/mp4" />
  </video>
</div>

<style is:global>
  /* The section that holds a MotionBackdrop. Its own background colour shows until the video starts. */
  .has-motion {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  .motion {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1.6s var(--ease);
  }

  .motion.is-playing {
    opacity: 1;
  }

  .motion video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .motion--fade video {
    -webkit-mask-image: linear-gradient(to bottom, #000 50%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 50%, transparent 100%);
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;

  if (!reduce && !saveData && 'IntersectionObserver' in window) {
    const start = () => {
      const pause = document.querySelector<HTMLButtonElement>('[data-motion-pause]');
      let userPaused = false;
      const syncs: Array<() => void> = [];

      document.querySelectorAll<HTMLElement>('[data-motion]').forEach((root) => {
        const video = root.querySelector('video');
        if (!video) return;

        let loaded = false;
        let onScreen = false;

        const sync = () => {
          if (onScreen && !userPaused) {
            if (!loaded) {
              // Hand the browser the real sources only now, so nothing downloads before it's needed.
              video.querySelectorAll('source').forEach((s) => s.setAttribute('src', s.dataset.src ?? ''));
              video.load();
              loaded = true;
            }
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        };
        syncs.push(sync);

        video.addEventListener(
          'playing',
          () => {
            root.classList.add('is-playing');
            if (pause) pause.hidden = false;
          },
          { once: true },
        );

        new IntersectionObserver(
          (entries) => {
            onScreen = entries.some((e) => e.isIntersecting);
            sync();
          },
          { rootMargin: '200px' },
        ).observe(root);
      });

      pause?.addEventListener('click', () => {
        userPaused = !userPaused;
        pause.textContent = userPaused ? 'Play animation' : 'Pause animation';
        syncs.forEach((sync) => sync());
      });
    };

    if (document.readyState === 'complete') start();
    else window.addEventListener('load', start, { once: true });
  }
</script>
