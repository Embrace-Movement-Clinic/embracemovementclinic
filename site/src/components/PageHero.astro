---
// Inner-page hero: breadcrumbs, eyebrow, title, lede, actions (slot "actions"),
// optional side content (slot "aside", e.g. a photo). Brand (dark) or light background.
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  title: string;
  eyebrow?: string;
  lede?: string;
  crumbs?: { label: string; href?: string }[];
  tone?: 'brand' | 'light';
  /** End in the brand curve. Turn off when another header band follows (e.g. the Pilates facts). */
  curve?: boolean;
}

const { title, eyebrow, lede, crumbs, tone = 'light', curve = true } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<section class:list={['page-hero', `page-hero--${tone}`, { 'on-brand': tone === 'brand', 'curve-bottom': curve }]} aria-labelledby="page-title">
  <div class:list={['wrap', 'page-hero__grid', { 'page-hero__grid--split': hasAside }]}>
    <div class="page-hero__text">
      {crumbs && <Breadcrumbs items={crumbs} onBrand={tone === 'brand'} />}
      {
        eyebrow && (
          <p class="eyebrow">
            {/* Keep hyphenated words like "One-on-one" on one line. */}
            {eyebrow.split(' ').map((w, i) => (
              <>
                {i > 0 && ' '}
                {w.includes('-') ? <span class="nowrap">{w}</span> : w}
              </>
            ))}
          </p>
        )
      }
      <h1 id="page-title">{title}</h1>
      {
        lede && (
          <p class="lede page-hero__lede">
            {/* A new line typed in the editor starts a new line here. */}
            {lede.split(/\n+/).map((line, i) => (
              <>
                {i > 0 && <br />}
                {line.trim()}
              </>
            ))}
          </p>
        )
      }
      <slot />
      {
        Astro.slots.has('actions') && (
          <div class="page-hero__actions">
            <slot name="actions" />
          </div>
        )
      }
    </div>
    {
      hasAside && (
        <div class="page-hero__aside">
          <slot name="aside" />
        </div>
      )
    }
  </div>
</section>

<style>
  .page-hero {
    padding-block: clamp(2rem, 1.25rem + 3.5vw, 4.5rem) clamp(2.5rem, 1.5rem + 4.5vw, 5.5rem);
  }

  .page-hero--light {
    background: var(--color-bg-alt);
  }

  .page-hero__grid {
    display: grid;
    gap: var(--space-l);
    align-items: center;
  }

  .page-hero__text {
    display: grid;
    gap: var(--space-s);
    justify-items: start;
    max-width: 44rem;
  }

  .page-hero__text :global(.crumbs) {
    margin-bottom: var(--space-xs);
  }

  .page-hero h1 {
    font-size: var(--step-5);
  }

  .page-hero__lede {
    max-width: 38rem;
  }

  .page-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    padding-top: var(--space-2xs);
  }

  .page-hero__aside :global(.photo) {
    border-radius: var(--radius-l);
  }

  /* One column (phones and tablets): the column is as wide as the screen allows, never as wide as
     its longest word, so with enlarged text a long word in the title breaks instead of pushing
     the page sideways. Beside a photo on wider screens, the text column grows to fit the title. */
  @media (max-width: 55.99em) {
    .page-hero__grid,
    .page-hero__text {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (min-width: 56em) {
    .page-hero__grid--split {
      grid-template-columns: 1.15fr 1fr;
      gap: var(--space-xl);
    }
  }
</style>
