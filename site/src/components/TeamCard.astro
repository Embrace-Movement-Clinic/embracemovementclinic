---
// Practitioner card: photo, name, titles, status, link to the profile.
import type { CollectionEntry } from 'astro:content';
import PhotoCard from './PhotoCard.astro';
import { isPast } from '../data/site';

interface Props {
  member: CollectionEntry<'team'>;
  /** Photo shape: square by default, wider on the Home and Team pages. */
  ratio?: string;
  sizes?: string;
}

const { member, ratio = '1 / 1', sizes = '(min-width: 62em) 24rem, (min-width: 40em) 50vw, 100vw' } = Astro.props;
const { name, titles, status, statusUntil, photo, photoPosition, photoNote } = member.data;
// The status (e.g. leave dates) goes after its end date: at build time, and on the day in the browser.
const showStatus = status && !isPast(statusUntil);
---

<PhotoCard href={`/team/${member.id}`} image={photo} imageNote={photoNote} imagePosition={photoPosition} ratio={ratio} sizes={sizes} more="View profile">
  <h3 class="h4">{name}</h3>
  <p class="team-card__titles">
    {titles.map((t, i) => (
      <>
        <span class="nowrap">{t}</span>
        {i < titles.length - 1 && ' · '}
      </>
    ))}
  </p>
  {showStatus && <p class="status-pill" data-hide-after={statusUntil}>{status}</p>}
</PhotoCard>

<style>
  .team-card__titles {
    color: var(--color-ink-muted);
    font-size: var(--step--1);
  }
</style>
