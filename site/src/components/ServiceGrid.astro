---
// Photo cards for the services, used on Home and Services, in two labelled groups: classes first
// (owner's choice, 7 Nov 2026), then one-on-one appointments.
// Wide screens: a tall classes card beside the one-on-one services in a 2×2 grid.
// Phones: compact rows (photo beside text).
import type { CollectionEntry } from 'astro:content';
import ServiceCard from './ServiceCard.astro';

interface Props {
  /** Services in display order. */
  services: CollectionEntry<'services'>[];
}

const { services } = Astro.props;
const groups = [
  // `sizes`: how wide each card's photo is drawn, so browsers fetch a file to match. On phones
  // it's a 6.5rem thumbnail; on tablets the classes card runs the full width.
  {
    kind: 'classes',
    label: 'Classes',
    list: services.filter((s) => s.data.kind === 'class'),
    sizes: '(min-width: 62em) 35vw, (min-width: 40em) 100vw, 6.5rem',
    widths: [240, 400, 640, 960, 1280],
  },
  {
    kind: 'appointments',
    label: 'One-on-one appointments',
    list: services.filter((s) => s.data.kind === 'appointment'),
    sizes: '(min-width: 62em) 30vw, (min-width: 40em) 50vw, 6.5rem',
    widths: [240, 400, 640, 960],
  },
];
---

<div class="service-groups">
  {
    groups.map(
      ({ kind, label, list, sizes, widths }) =>
        list.length > 0 && (
          <>
          <h3 class:list={['eyebrow', 'group-label', `group-label--${kind}`]}>
            {kind === 'appointments' ? (
              <>
                <span class="nowrap">One-on-one</span> appointments
              </>
            ) : (
              label
            )}
          </h3>
          <ul class:list={['cards', `cards--${kind}`]} role="list">
            {list.map((s) => (
              // Card titles sit under their group's small heading ("One-on-one appointments", "Classes").
              <li class="card">
                <ServiceCard service={s} as="h4" compact widths={widths} sizes={sizes} />
              </li>
            ))}
          </ul>
          </>
        ),
    )
  }
</div>

<style>
  .service-groups {
    display: grid;
    /* minmax(0, 1fr): the column is as wide as the space available, never as wide as its longest word. */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-m);
  }

  .group-label {
    margin-bottom: calc(var(--space-xs) - var(--space-m));
  }

  .cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-m);
  }

  @media (min-width: 40em) {
    .cards--appointments {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 40em) and (max-width: 61.99em) {
    .cards--classes {
      --photo-ratio-override: 2 / 1;
    }
  }

  /* Below wide screens the one-on-one group follows the classes card: a rule and its label set it apart. */
  @media (max-width: 61.99em) {
    .group-label--appointments {
      margin-top: var(--space-s);
      padding-top: var(--space-l);
      border-top: 1px solid var(--color-line);
    }
  }

  /* Wide screens: the classes card on the left, the one-on-one 2×2 grid beside it, labels and tops aligned. */
  @media (min-width: 62em) {
    .service-groups {
      grid-template-columns: 1.1fr 2fr;
      grid-template-rows: auto 1fr;
      gap: var(--space-xs) var(--space-xl);
    }

    .group-label {
      margin-bottom: 0;
    }

    .group-label--appointments {
      grid-column: 2;
      grid-row: 1;
    }

    .cards--appointments {
      grid-column: 2;
      grid-row: 2;
    }

    .group-label--classes {
      grid-column: 1;
      grid-row: 1;
    }

    .cards--classes {
      grid-column: 1;
      grid-row: 2;
      grid-template-rows: 1fr;
    }

    /* The tall classes card: its photo fills whatever height is left above the text. */
    .cards--classes .card :global(.photo-card) {
      grid-template-rows: 1fr auto;
    }

    .cards--classes :global(picture) {
      display: block;
      position: relative;
      min-height: 18rem;
    }

    .cards--classes :global(.photo) {
      --photo-ratio-override: auto;
      position: absolute;
      inset: 0;
      height: 100%;
    }
  }

  /* Phones: compact rows, with a small photo beside the text. */
  @media (max-width: 39.99em) {
    .cards {
      gap: var(--space-s);
    }

    .card :global(.photo-card) {
      grid-template-columns: 6.5rem minmax(0, 1fr);
      grid-template-rows: none;
    }

    .card :global(picture) {
      display: block;
      position: relative;
    }

    .card :global(.photo) {
      --photo-ratio-override: auto;
      position: absolute;
      inset: 0;
      height: 100%;
    }

    .card :global(.service-card__text) {
      font-size: var(--step--1);
    }
  }
</style>
