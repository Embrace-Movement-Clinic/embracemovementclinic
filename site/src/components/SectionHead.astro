---
// Section heading block: optional eyebrow, the heading (with an optional icon badge), an optional
// intro, and an optional link on the right. Pass the title as `title`, or as the slot when it
// needs markup (e.g. a non-breaking phrase).
import Icon, { type IconName } from './Icon.astro';
import IconBadge from './IconBadge.astro';

interface Props {
  id: string;
  title?: string;
  eyebrow?: string;
  intro?: string;
  link?: { href: string; label: string };
  as?: 'h1' | 'h2' | 'h3';
  /** Icon badge to the left of the heading. */
  icon?: IconName;
  /** "s": a smaller heading and less space under it, for pages made of many short sections. */
  size?: 'm' | 's';
  /** Let the intro run the full width, rather than stopping at a comfortable line length. */
  wide?: boolean;
  class?: string;
}

const { id, title, eyebrow, intro, link, as: Heading = 'h2', icon, size = 'm', wide = false, class: className } = Astro.props;
---

<div class:list={['section-head', `section-head--${size}`, { 'section-head--wide': wide }, className]}>
  <div class="section-head__text">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <Heading id={id} class:list={['section-head__title', { badged: icon }]}>
      {icon && <IconBadge name={icon} size="l" />}
      <span><slot>{title}</slot></span>
    </Heading>
    {intro && <p class="section-head__intro">{intro}</p>}
  </div>
  {
    link && (
      <a class="section-head__link arrow-link" href={link.href}>
        {link.label} <Icon name="arrow-right" size={18} />
      </a>
    )
  }
</div>

<style>
  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-s) var(--space-l);
    margin-bottom: var(--space-l);
  }

  .section-head--s {
    margin-bottom: var(--space-m);
  }

  .section-head__text {
    display: grid;
    gap: var(--space-xs);
  }

  /* h1 sections (e.g. a page that opens with this block) keep the section-heading size. */
  h1.section-head__title {
    font-size: var(--step-4);
  }

  .section-head--s .section-head__title {
    font-size: var(--step-3);
  }

  .section-head__intro {
    max-width: 46rem;
    color: var(--color-ink-muted);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .section-head--wide .section-head__intro {
    max-width: none;
  }

  .section-head__link {
    min-height: 2.75rem;
  }
</style>
